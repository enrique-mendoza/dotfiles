{
  "editorMode": "vim",
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "remember@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "permissions": {
    "allow": [
      "Agent(*)",
      "Bash",
      "WebFetch(domain:*)"
    ],
    "ask": [
      "Edit",
      "NotebookEdit",
      "Write"
    ],
    "defaultMode": "default",
    "deny": [
      "Read(.env)",
      "Read(./secrets/**)",
      "Bash(git commit*)",
      "Bash(git -C * commit*)"
    ]
  },
  "statusLine": {
    "command": "npx ccusage@latest statusline",
    "type": "command"
  },
  "theme": "auto"
}
